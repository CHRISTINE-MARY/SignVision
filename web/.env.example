# Public URL of the API on the Oracle VM. https, no trailing slash.
# Set this in Vercel (Settings → Environment Variables), not on the VM.
# Leave it empty when the page is served by FastAPI on the same machine.
SIGNVISION_API_ORIGIN=https://api.yourdomain.com

# On the Oracle VM only. Refuses the digit-classifier fallback.
SIGNVISION_MODEL=transformer

# On the Oracle VM only. Comma-separated page origins allowed to call the API.
# Example: https://your-app.vercel.app
SIGNVISION_CORS_ORIGINS=https://your-app.vercel.app
